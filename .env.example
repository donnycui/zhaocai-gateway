# Runtime
ZHAOCAI_PORT=8000
ZHAOCAI_HOST=0.0.0.0
ZHAOCAI_LOG_LEVEL=info
ZHAOCAI_CONFIG=./config.yaml
ZHAOCAI_APP_TITLE=Zhaocai Gateway
ZHAOCAI_APP_DESCRIPTION=AI Provider Gateway + OpenClaw Control Plane
ZHAOCAI_APP_VERSION=2.0.0

# Control plane storage
ZHAOCAI_ADMIN_TOKEN=REPLACE_WITH_STRONG_ADMIN_TOKEN
ZHAOCAI_CONTROL_DB=sqlite:///./data/control_plane.db
ZHAOCAI_ENCRYPTION_KEY=

# Legacy runtime compatibility
# The current branch still keeps gateway.py and legacy control-plane paths alive.
ZHAOCAI_ROUTING_SOURCE=hybrid
ZHAOCAI_CONTROL_SYNC_INTERVAL_SECONDS=5
ZHAOCAI_NODE_PROVIDER_MODE=gateway
ZHAOCAI_NODE_GATEWAY_PROVIDER_ID=zhaocai-gateway
ZHAOCAI_NODE_GATEWAY_BASE_URL=http://raspberrypi.local:8000/v1
ZHAOCAI_NODE_GATEWAY_PROVIDER_TYPE=openai
ZHAOCAI_NODE_GATEWAY_AUTH_SCHEME=bearer
ZHAOCAI_NODE_GATEWAY_API_KEY=
ZHAOCAI_NODE_GATEWAY_EXTRA_HEADERS={}

# Optional provider keys for legacy config.yaml driven startup
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
NVIDIA_API_KEY=nvapi-...
DASHSCOPE_API_KEY=sk-...
SILICONFLOW_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# Optional private-network / edge setup
CF_TUNNEL_TOKEN=eyJ...

# Node agent notes
# The v2 node-agent stores its own local state in ~/.zhaocai-gateway/agent.json by default.
# Device registration currently uses the /agent/v1/register API and does not require extra env vars.
